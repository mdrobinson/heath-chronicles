---
import Map from '../components/Map.astro';
import About from '../components/About.astro';
import { fetchAllMediaFromFolder } from '../utils/cloudinary-media';
const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
export interface Marker {
  lat: number;
  lng: number;
  title: string;
  location: string;
  identifier: string;
  optimizedUrl: string;
  thumbnailUrl: string;
  placedBy: string;
  mediaType: string;
}

let markers: Marker[] = [];
const mediaData = await fetchAllMediaFromFolder('');
mediaData.all.forEach((media) => {
  if (
    media.context.custom &&
    media.context.custom.lat &&
    media.context.custom.long &&
    media.context.custom.caption &&
    media.context.custom.alt &&
    media.context.custom.identifier &&
    media.context.custom['placed-by']
  ) {
    const thisMarker: Marker = {
      lat: Number(media.context.custom.lat),
      lng: Number(media.context.custom.long),
      title: media.context.custom.caption,
      location: media.context.custom.alt,
      identifier: media.context.custom.identifier,
      optimizedUrl: media.optimizedUrl,
      thumbnailUrl: media.thumbnailUrl,
      placedBy: media.context.custom['placed-by'],
      mediaType: media.resourceType,
    };
    markers.push(thisMarker);
  }
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Heath Chronicles</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <div id="header">
        <h1>The Heath Chronicles</h1>
      </div>

      <Map apiKey={apiKey} markers={markers} zoom={4} />
      <About />
    </main>
  </body>
</html>

<style>
